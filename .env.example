# Copy this file to .env.local and fill in real values from the Firebase console
# (Project settings > General > Your apps > SDK setup and configuration).
# .env.local is gitignored — never commit real values.
#
# These values are still bundled into the public client build (Vite inlines
# VITE_ vars at build time) — that's expected for Firebase web config. Actual
# access control is enforced by firestore.rules / storage.rules, not by
# hiding these values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

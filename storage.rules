rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    match /products/{fileName} {
      // Product photos are shown to every visitor.
      allow read: if true;

      // Only the signed-in admin may upload, and only small image files —
      // mirrors the client-side check in src/pages/Admin.jsx but is the
      // check that actually can't be bypassed from the browser.
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
